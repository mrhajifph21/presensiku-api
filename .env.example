PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=db_hris

# WAJIB: string acak minimal 32 karakter. Tanpa ini server menolak start.
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
CORS_ORIGIN=http://localhost:5173

# PSI-355: zkteco_logs sink (company attendance DB, MySQL 201).
# Produksi (Docker di 201): host 127.0.0.1, db_hris. Dev lokal: mirror
# Laragon saja - JANGAN pernah menulis ke 201/202.
ZK_DB_HOST=127.0.0.1
ZK_DB_USER=root
ZK_DB_PASSWORD=
ZK_DB_NAME=db_hris

# Dual-write: jalur tulis lama (tabel presensiku@202). Default ON sampai
# cutover zkteco_logs terverifikasi; pencabutan jadi follow-up.
DUAL_WRITE_LEGACY=true

OFFICE_LATITUDE=-6.5971120
OFFICE_LONGITUDE=106.8059730
OFFICE_RADIUS_METER=100
